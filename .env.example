APP_ENV=development
PROJECT_NAME=switch-audit
DEBUG=true

# LLM 配置（支持任何 OpenAI 兼容接口）
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=         # 自定义端点，如本地模型或第三方 API，留空则使用 OpenAI 默认
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.1

# LangSmith 追踪（可选，开启后在 smith.langchain.com 查看完整推理链路）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=switch-audit

# SSH — 目标设备凭证（Docker mock 用 2222，真实交换机用 22）
SSH_PORT=22
SSH_USERNAME=admin
SSH_PASSWORD=admin
SSH_TIMEOUT=10

# 日志
LOG_DIR=logs
LOG_LEVEL=DEBUG
LOG_FORMAT=console       # console（开发）| json（生产）
